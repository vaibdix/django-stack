# Build output
#
# The binary names below are ANCHORED with a leading slash so they match only at
# the repository root. Unanchored, `django-stack` also matches the directory
# cmd/django-stack/ — which silently excluded the entire CLI source from the
# repository. A leading slash is not cosmetic here.
/dist/
/cli
/django-stack
/django-stack.exe
*.exe
*.dll
*.so
*.dylib

# Test and coverage artifacts
#
# test/projects/ holds projects generated for manual verification, and
# test/gen and test/django-stack are binaries built for it.
/test/projects/
/test/gen
/test/django-stack
coverage.txt
coverage.out
*.golden.new
*.sqlite3

# Python
.venv/
vscode-test/
__pycache__/

# Editor and OS
.DS_Store
/.github/
.idea/
*.swp

# Agent tooling
.claude/
/.agents/

# GoReleaser
.goreleaser-snapshot/
