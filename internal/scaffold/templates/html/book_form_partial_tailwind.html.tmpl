<form method="post" hx-post hx-target="#book-list" hx-swap="innerHTML" class="rounded-[28px] border border-white/10 bg-white/[0.03] p-8 shadow-[0_0_0_1px_rgba(255,255,255,0.02)]">
    {% csrf_token %}
    <div class="space-y-6">
        <div class="space-y-2">
            <label class="text-sm font-medium text-white/82">Title</label>
            {{ form.title }}
        </div>
        <div class="space-y-2">
            <label class="text-sm font-medium text-white/82">Author</label>
            {{ form.author }}
        </div>
        <div class="space-y-2">
            <label class="text-sm font-medium text-white/82">ISBN</label>
            {{ form.isbn }}
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
                <label class="text-sm font-medium text-white/82">Publication date</label>
                {{ form.publication_date }}
            </div>
            <div class="space-y-2">
                <label class="text-sm font-medium text-white/82">Price (USD)</label>
                {{ form.price }}
            </div>
        </div>
    </div>
    <div class="mt-8 flex flex-col gap-3 border-t border-white/8 pt-6 sm:flex-row">
        <a href="/[[.AppName]]/" class="inline-flex flex-1 items-center justify-center rounded-full border border-white/12 px-5 py-3 text-sm font-medium text-white/80 transition hover:border-white/25 hover:text-white">
            Cancel
        </a>
        <button type="submit" class="inline-flex flex-1 items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-black transition hover:bg-white/90">
            {{ action }} Book
        </button>
    </div>
</form>
