<form method="post" hx-post="{{ request.path }}" hx-target="#book-list" hx-swap="innerHTML" class="panel p-6 max-lg:p-5">
    {% csrf_token %}
    <div class="space-y-4">
        <div>
            <label class="block text-body">Title</label>
            {{ form.title }}
        </div>
        <div>
            <label class="block text-body">Author</label>
            {{ form.author }}
        </div>
        <div>
            <label class="block text-body">ISBN</label>
            {{ form.isbn }}
        </div>
        <div class="flex gap-4 max-sm:flex-col">
            <div class="flex-1">
                <label class="block text-body">Publication date</label>
                {{ form.publication_date }}
            </div>
            <div class="flex-1">
                <label class="block text-body">Price (USD)</label>
                {{ form.price }}
            </div>
        </div>
    </div>
    <div class="mt-6 flex gap-2 border-t border-rule pt-6 max-sm:flex-col">
        <a href="{% url '[[.AppName]]:book_list' %}" class="button button-secondary flex-1">Cancel</a>
        <button type="submit" class="button button-primary flex-1">{{ action }} book</button>
    </div>
</form>
