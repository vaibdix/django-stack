{% extends 'base.html' %}
{% block title %}[[.AppName]] - Book Library{% endblock %}
{% block extra_head %}
<style>
.book-page { padding: 48px 32px; }
.book-page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
.book-page-intro { max-width: 640px; }
.book-page-intro h1 { margin: 24px 0 8px; }
.book-page-desc { color: var(--body); }
.book-toolbar-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.book-search { max-width: 420px; font-family: var(--font-sans); font-size: 15px; line-height: 145%; padding: 6px 12px; border: 1px solid var(--rule); border-radius: 6px; background: var(--ground); color: var(--heading); outline: none; transition: border-color 0.3s; width: 100%; }
.book-search:focus { border-color: var(--accent-border); }
.book-search::placeholder { color: var(--body); }
.book-message { border: 1px solid var(--rule); background: var(--surface); border-radius: 6px; padding: 6px 12px; color: var(--body); margin-bottom: 8px; }
.book-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.book-card { border: 1px solid var(--rule); border-radius: 8px; padding: 24px; transition: box-shadow 0.3s; }
.book-card:hover { box-shadow: var(--shadow); }
.book-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.book-card-title { margin: 0; }
.book-card-details { margin-top: 16px; }
.book-card-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 0; color: var(--body); }
.book-card-row:not(:last-child) { border-bottom: 1px solid var(--rule); }
.book-card-row-value { text-align: right; color: var(--heading); }
.book-card-actions { display: flex; gap: 8px; margin-top: 24px; }
.book-card-actions > * { flex: 1; }
.book-empty { border: 1px solid var(--rule); border-radius: 8px; padding: 48px 24px; text-align: center; }
.book-empty-desc { color: var(--body); max-width: 480px; margin: 0 auto; }
.book-empty-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 24px; }
@media (max-width: 1280px) { .book-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 1024px) {
    .book-page { padding: 32px 20px; }
    .book-page-header { flex-direction: column; align-items: flex-start; }
    .book-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}
{% block content %}
<section class="book-page">
    <div class="book-page-header">
        <div class="book-page-intro">
            <span class="badge">Example CRUD workspace</span>
            <h1>Book library</h1>
            <p class="book-page-desc">Manage titles, authors, pricing and publishing dates. Everything here is also available in <a href="/admin/">Django admin</a>.</p>
        </div>
        <div class="book-toolbar-actions">
            <a href="/admin/" class="button button-secondary">Open admin</a>
            <a href="/[[.AppName]]/create/" class="button button-primary">Add book</a>
        </div>
    </div>
[[if .HTMX]]
    <div style="margin-bottom:24px">
        <input type="search" name="q" placeholder="Search books by title..."
               hx-get="/[[.AppName]]/search/"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#book-list"
               hx-swap="innerHTML"
               class="book-search">
    </div>
[[end]]
    {% if messages %}
    <div style="margin-bottom:24px">
        {% for message in messages %}
        <div class="book-message">{{ message }}</div>
        {% endfor %}
    </div>
    {% endif %}

    {% if books %}[[if .HTMX]]
    <div id="book-list" class="book-grid">[[else]]
    <div class="book-grid">[[end]]
        {% for book in books %}[[if .HTMX]]
        <article id="book-{{ book.id }}" class="book-card">[[else]]
        <article class="book-card">[[end]]
            <div class="book-card-header">
                <h3 class="book-card-title">{{ book.title }}</h3>
                <code>${{ book.price }}</code>
            </div>
            <div class="book-card-details">
                <div class="book-card-row"><span>Author</span><span class="book-card-row-value">{{ book.author }}</span></div>
                <div class="book-card-row"><span>ISBN</span><span class="book-card-row-value">{{ book.isbn }}</span></div>
                <div class="book-card-row"><span>Published</span><span class="book-card-row-value">{{ book.publication_date }}</span></div>
            </div>
            <div class="book-card-actions">
                <a href="/[[.AppName]]/edit/{{ book.id }}/" class="button button-secondary">Edit</a>[[if .HTMX]]
                <button hx-post="/[[.AppName]]/delete/{{ book.id }}/" hx-target="closest article" hx-swap="outerHTML" hx-confirm="Delete this book?" class="button button-primary">Delete</button>[[else]]
                <a href="/[[.AppName]]/delete/{{ book.id }}/" class="button button-primary">Delete</a>[[end]]
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div class="book-empty">
        <h2>No books yet</h2>
        <p class="book-empty-desc">Start with a single title and the library becomes visible in both this page and the Django admin.</p>
        <div class="book-empty-actions">
            <a href="/[[.AppName]]/create/" class="button button-primary">Add your first book</a>
            <a href="/admin/" class="button button-secondary">Open Django admin</a>
        </div>
    </div>
    {% endif %}
</section>
{% endblock %}
