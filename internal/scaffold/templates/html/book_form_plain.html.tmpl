{% extends 'base.html' %}
{% block title %}{{ action }} Book - [[.AppName]]{% endblock %}
{% block extra_head %}
<style>
.form-page { padding: 28px 32px; }
.form-grid { display: flex; gap: 24px; }
.form-intro { width: 340px; flex-shrink: 0; }
.form-intro h1 { margin-top: 0; }
.form-intro p { color: var(--body); }
.form-intro p + p { margin-top: 16px; }
.form-panel { flex: 1; border: 1px solid var(--rule); border-radius: 8px; padding: 24px; }
.form-fields > * + * { margin-top: 16px; }
.form-field label { display: block; color: var(--body); }
.form-panel input, .form-panel select, .form-panel textarea { width: 100%; margin-top: 8px; border-radius: 6px; border: 1px solid var(--rule); background: var(--ground); padding: 6px 12px; font-size: 15px; font-family: var(--font-sans); line-height: 145%; color: var(--heading); outline: none; transition: border-color 0.3s; }
.form-panel input:focus, .form-panel select:focus, .form-panel textarea:focus { border-color: var(--accent-border); }
.form-panel input::placeholder { color: var(--body); }
.form-row { display: flex; gap: 16px; }
.form-row > * { flex: 1; }
.form-actions { display: flex; gap: 8px; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--rule); }
.form-actions > * { flex: 1; }
@media (max-width: 1024px) {
    .form-page { padding: 24px 20px; }
    .form-grid { flex-direction: column; }
    .form-intro { width: 100%; }
    .form-panel { padding: 20px; }
}
@media (max-width: 640px) {
    .form-row { flex-direction: column; }
    .form-actions { flex-direction: column; }
}
</style>
{% endblock %}
{% block content %}
<section class="form-page">
    <div class="form-grid">
        <div class="form-intro">
            <h1>{{ action }} book</h1>
            <p>Keep the catalog clean with consistent title, author, ISBN, publishing date and pricing data.</p>
            <p>Once saved, the record is available in both this page and <a href="/admin/">Django admin</a>.</p>
        </div>

        <form method="post" class="form-panel">
            {% csrf_token %}
            <div class="form-fields">
                <div class="form-field">
                    <label>Title</label>
                    {{ form.title }}
                </div>
                <div class="form-field">
                    <label>Author</label>
                    {{ form.author }}
                </div>
                <div class="form-field">
                    <label>ISBN</label>
                    {{ form.isbn }}
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label>Publication date</label>
                        {{ form.publication_date }}
                    </div>
                    <div class="form-field">
                        <label>Price (USD)</label>
                        {{ form.price }}
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <a href="/[[.AppName]]/" class="button button-secondary">Cancel</a>
                <button type="submit" class="button button-primary">{{ action }} book</button>
            </div>
        </form>
    </div>
</section>
{% endblock %}
