{% extends 'base.html' %}
{% block title %}Delete Book - [[.AppName]]{% endblock %}
{% block extra_head %}
<style>
.delete-page { display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 3.5rem 1.5rem; }
.delete-card { width: 100%; max-width: 40rem; border: 1px solid var(--rule); background: var(--surface); border-radius: 16px; padding: 2rem; text-align: center; }
@media (min-width: 640px) { .delete-card { padding: 3rem; } }
.delete-icon { display: flex; align-items: center; justify-content: center; width: 3.5rem; height: 3.5rem; margin: 0 auto; border-radius: 9999px; border: 1px solid var(--accent); background: var(--accent-bg); }
.delete-icon svg { color: var(--accent); }
.delete-label { margin-top: 1.5rem; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--accent); }
.delete-title { margin-top: 0.75rem; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.035em; color: var(--heading); }
.delete-desc { margin: 0.75rem auto 0; max-width: 32rem; font-size: 0.875rem; line-height: 1.75; color: var(--body); }
.delete-desc strong { font-weight: 500; color: var(--heading); }
.delete-actions { display: flex; flex-direction: column; gap: 0.75rem; max-width: 28rem; margin: 2rem auto 0; }
@media (min-width: 640px) { .delete-actions { flex-direction: row; } }
.delete-actions a, .delete-actions button { flex: 1; text-align: center; }
.btn-secondary { display: inline-flex; align-items: center; justify-content: center; padding: 0.7rem 1.2rem; border-radius: 9999px; background: transparent; color: var(--heading); font-size: 0.875rem; font-weight: 500; text-decoration: none; border: 1px solid var(--rule); cursor: pointer; transition: border-color 0.2s ease, color 0.2s ease; }
.btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
.btn-danger { display: inline-flex; align-items: center; justify-content: center; padding: 0.7rem 1.2rem; border-radius: 9999px; background: var(--accent-bg); border: 1px solid var(--accent); color: var(--accent); font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s ease; }
.btn-danger:hover { background: color-mix(in srgb, var(--accent) 22%, var(--ground)); }
</style>
{% endblock %}
{% block content %}
<section class="delete-page">
    <div class="delete-card">
        <div class="delete-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
        </div>
        <p class="delete-label">Confirm removal</p>
        <h2 class="delete-title">Delete this book?</h2>
        <p class="delete-desc">You are about to remove <strong>{{ book.title }}</strong>. The book disappears from the custom library UI and from Django admin immediately.</p>

        <form method="post" class="delete-actions">
            {% csrf_token %}
            <a href="/[[.AppName]]/" class="btn-secondary">Keep book</a>
            <button type="submit" class="btn-danger">Delete permanently</button>
        </form>
    </div>
</section>
{% endblock %}
