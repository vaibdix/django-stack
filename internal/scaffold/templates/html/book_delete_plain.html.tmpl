{% extends 'base.html' %}
{% block title %}Delete Book - [[.AppName]]{% endblock %}
{% block extra_head %}
<style>
.delete-page { display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 48px 20px; }
.delete-card { width: 100%; max-width: 560px; border: 1px solid var(--rule); border-radius: 8px; padding: 32px; text-align: center; }
.delete-desc { color: var(--body); max-width: 420px; margin: 0 auto; }
.delete-desc strong { color: var(--heading); font-weight: 500; }
.delete-actions { display: flex; gap: 8px; justify-content: center; margin-top: 24px; }
@media (max-width: 640px) { .delete-actions { flex-direction: column; } }
</style>
{% endblock %}
{% block content %}
<section class="delete-page">
    <div class="delete-card">
        <h2>Delete this book?</h2>
        <p class="delete-desc">You are about to remove <strong>{{ book.title }}</strong>. It disappears from this page and from Django admin immediately.</p>

        <form method="post" class="delete-actions">
            {% csrf_token %}
            <a href="/[[.AppName]]/" class="button button-secondary">Keep book</a>
            <button type="submit" class="button button-primary">Delete permanently</button>
        </form>
    </div>
</section>
{% endblock %}
