{% extends 'base.html' %}
{% block title %}[[.AppName]] - Book Library{% endblock %}
{% block content %}
<section class="px-8 py-7 max-lg:px-5 max-lg:py-6">
    <div class="mb-6 flex items-end justify-between gap-6 max-lg:flex-col max-lg:items-start">
        <div class="max-w-[640px]">
            <span class="badge">Example CRUD workspace</span>
            <h1 class="mt-4 mb-2">Book library</h1>
            <p class="text-body">Manage titles, authors, pricing and publishing dates. Everything here is also available in <a href="/admin/">Django admin</a>.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/admin/" class="button button-secondary">Open admin</a>
            <a href="{% url '[[.AppName]]:book_create' %}" class="button button-primary">Add book</a>
        </div>
    </div>
[[if .HTMX]]
    <div class="mb-6">
        <input type="search" name="q" placeholder="Search books by title..."
               hx-get="{% url '[[.AppName]]:book_search' %}"
               hx-trigger="keyup changed delay:300ms, search"
               hx-target="#book-list"
               hx-swap="innerHTML"
               hx-push-url="true"
               hx-indicator="#book-list"
               class="max-w-[420px]">
    </div>
[[end]]
    {% if messages %}
    <div class="mb-6 space-y-2">
        {% for message in messages %}
        <div class="rounded-[6px] border border-rule bg-surface px-3 py-2 text-body">{{ message }}</div>
        {% endfor %}
    </div>
    {% endif %}

    {% if books %}[[if .HTMX]]
    <div id="book-list" class="grid grid-cols-3 gap-4 max-xl:grid-cols-2 max-lg:grid-cols-1">[[else]]
    <div class="grid grid-cols-3 gap-4 max-xl:grid-cols-2 max-lg:grid-cols-1">[[end]]
        {% for book in books %}[[if .HTMX]]
        <article id="book-{{ book.id }}" class="panel card-hover p-5">[[else]]
        <article class="panel card-hover p-5">[[end]]
            <div class="flex items-start justify-between gap-4">
                <h3 class="m-0">{{ book.title }}</h3>
                <code>${{ book.price }}</code>
            </div>
            <div class="mt-3 space-y-1.5 text-body">
                <div class="flex items-center justify-between gap-4 border-b border-rule pb-2">
                    <span>Author</span>
                    <span class="text-right text-heading">{{ book.author }}</span>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-rule pb-2">
                    <span>ISBN</span>
                    <span class="text-right text-heading">{{ book.isbn }}</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span>Published</span>
                    <span class="text-right text-heading">{{ book.publication_date }}</span>
                </div>
            </div>
            <div class="mt-4 flex gap-2">
                <a href="{% url '[[.AppName]]:book_edit' book.id %}" class="button button-secondary flex-1">Edit</a>[[if .HTMX]]
                <button hx-post="{% url '[[.AppName]]:book_delete' book.id %}" hx-target="closest article" hx-swap="outerHTML" hx-confirm="Delete this book?" class="button button-primary flex-1">Delete</button>[[else]]
                <a href="{% url '[[.AppName]]:book_delete' book.id %}" class="button button-primary flex-1">Delete</a>[[end]]
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div class="panel px-6 py-10 text-center">
        <h2>No books yet</h2>
        <p class="mx-auto max-w-[480px] text-body">Start with a single title and the library becomes visible in both this page and the Django admin.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
            <a href="{% url '[[.AppName]]:book_create' %}" class="button button-primary">Add your first book</a>
            <a href="/admin/" class="button button-secondary">Open Django admin</a>
        </div>
    </div>
    {% endif %}
</section>
{% endblock %}
