@import "tailwindcss";

/* The design tokens, declared so Tailwind generates utilities for them.
 *
 * Tailwind v4 turns each --color-<name> here into text-<name>, bg-<name> and
 * border-<name>, so the markup names what a colour is for instead of how
 * translucent it is. The values match internal/assets/templ/css/base.css and
 * the dark column of the CLI's own palette, so the Tailwind and plain-CSS
 * variants of a generated project look the same.
 *
 * This block used to declare a light shadcn palette — --color-primary,
 * --color-card, sidebar and chart tokens — while every template styled itself
 * with white-opacity literals and body was hardcoded to black. None of those
 * tokens was ever referenced by anything. */
@theme {
  --color-ground: #16171d;
  --color-surface: #22232b;
  --color-rule: #2e303a;
  --color-heading: #f3f4f6;
  --color-body: #9ca3af;
  --color-accent: #c084fc;
  --color-accent-bg: #2f273e;
  --color-code-bg: #1f2028;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background-color: var(--color-ground);
  color: var(--color-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* The framed column: a fixed-width centre with a rule down each side, matching
 * the .frame rule in the plain-CSS stylesheet. */
.frame {
  max-width: 1126px;
  margin-inline: auto;
  border-inline: 1px solid var(--color-rule);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
}

/* A horizontal rule with a mark at each end, drawn with borders so it needs no
 * image and follows the rule colour. */
.ticks {
  position: relative;
  border-top: 1px solid var(--color-rule);
}
.ticks::before,
.ticks::after {
  content: "";
  position: absolute;
  top: -3px;
  width: 5px;
  height: 5px;
  border: 1px solid var(--color-rule);
  background: var(--color-ground);
}
.ticks::before { left: -3px; }
.ticks::after { right: -3px; }

.card-hover {
  transition: border-color 0.2s ease;
}
.card-hover:hover {
  border-color: var(--color-accent);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  border-radius: 9999px;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0.7rem 1.35rem;
  border: 1px solid transparent;
  transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  cursor: pointer;
}

.btn-primary {
  background-color: var(--color-accent-bg);
  border-color: var(--color-accent);
  color: var(--color-accent);
}
.btn-primary:hover {
  background-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-ground));
}

.btn-secondary {
  border-color: var(--color-rule);
  color: var(--color-heading);
}
.btn-secondary:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

input, select, textarea {
  width: 100%;
  padding: 0.65rem 0.9rem;
  border: 1px solid var(--color-rule);
  border-radius: 12px;
  background-color: var(--color-surface);
  color: var(--color-heading);
  font-size: 0.875rem;
  transition: border-color 0.2s ease;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--color-accent);
}
input::placeholder, textarea::placeholder { color: var(--color-body); }

code {
  background-color: var(--color-code-bg);
  color: var(--color-heading);
  border-radius: 6px;
  padding: 0.15em 0.4em;
  font-size: 0.9em;
}

.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 9999px;
  padding: 0.45rem 0.9rem;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-in {
  animation: fadeIn 0.3s ease-out forwards;
}
