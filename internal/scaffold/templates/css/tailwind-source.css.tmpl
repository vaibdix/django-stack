@import "tailwindcss";

@source "../templates/**/*.html";
@source "../*/templates/**/*.html";
@source "../*/*.py";

@theme {
  --color-ground: #fff;
  --color-surface: rgba(244, 243, 236, 0.5);
  --color-rule: #e5e4e7;
  --color-heading: #08060d;
  --color-body: #6b6375;
  --color-accent: #aa3bff;
  --color-accent-bg: rgba(170, 59, 255, 0.1);
  --color-accent-border: rgba(170, 59, 255, 0.5);
  --color-code-bg: #f4f3ec;
  --color-danger: #c0264c;
  --color-success: #17693f;

  --font-sans: system-ui, 'Segoe UI', Roboto, sans-serif;
  --font-mono: ui-monospace, Consolas, monospace;

  --radius-chip: 4px;
  --radius-btn: 5px;
  --radius-pill: 6px;
  --radius-card: 8px;
}

:root {
  --shadow-lift:
    rgba(0, 0, 0, 0.1) 0 10px 15px -3px, rgba(0, 0, 0, 0.05) 0 4px 6px -2px;
  color-scheme: light dark;
  font: 16px/150% var(--font-sans);
  letter-spacing: 0.18px;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Tailwind requires @theme at the top level, so dark mode overrides the same
   custom properties on :root instead of nesting a second @theme here. */
@media (prefers-color-scheme: dark) {
  :root {
    --color-ground: #16171d;
    --color-surface: rgba(47, 48, 58, 0.5);
    --color-rule: #2e303a;
    --color-heading: #f3f4f6;
    --color-body: #9ca3af;
    --color-accent: #c084fc;
    --color-accent-bg: rgba(192, 132, 252, 0.15);
    --color-accent-border: rgba(192, 132, 252, 0.5);
    --color-code-bg: #1f2028;
    --color-danger: #ff8095;
    --color-success: #4ade80;
    --shadow-lift:
      rgba(0, 0, 0, 0.4) 0 10px 15px -3px, rgba(0, 0, 0, 0.25) 0 4px 6px -2px;
  }
}

@media (max-width: 1024px) {
  :root { font-size: 15px; }
}

body {
  margin: 0;
  background: var(--color-ground);
  color: var(--color-body);
}

h1, h2, h3 {
  font-family: var(--font-sans);
  font-weight: 500;
  color: var(--color-heading);
}

h1 {
  font-size: 42px;
  letter-spacing: -1.26px;
  line-height: 105%;
  margin: 24px 0;
}

h2 {
  font-size: 21px;
  line-height: 118%;
  letter-spacing: -0.24px;
  margin: 0 0 8px;
}

h3 {
  font-size: 17px;
  line-height: 125%;
  letter-spacing: -0.2px;
  margin: 0 0 8px;
}

@media (max-width: 1024px) {
  h1 { font-size: 30px; margin: 20px 0; }
  h2 { font-size: 18px; }
}

p { margin: 0; }

code {
  font-family: var(--font-mono);
  display: inline-flex;
  font-size: 14px;
  line-height: 135%;
  padding: 4px 8px;
  border-radius: var(--radius-chip);
  color: var(--color-heading);
  background: var(--color-code-bg);
}

.frame {
  width: 1126px;
  max-width: 100%;
  margin: 0 auto;
  border-inline: 1px solid var(--color-rule);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.ticks {
  position: relative;
  width: 100%;
  border-top: 1px solid var(--color-rule);
}
.ticks::before,
.ticks::after {
  content: '';
  position: absolute;
  top: -4.5px;
  border: 5px solid transparent;
}
.ticks::before { left: 0; border-left-color: var(--color-rule); }
.ticks::after { right: 0; border-right-color: var(--color-rule); }

.button {
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 145%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 5px 10px;
  border-radius: var(--radius-btn);
  text-decoration: none;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.3s, box-shadow 0.3s;
}
.button:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.button-primary {
  color: var(--color-accent);
  background: var(--color-accent-bg);
}
.button-primary:hover { border-color: var(--color-accent-border); }

.button-secondary {
  color: var(--color-heading);
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  padding: 6px 12px;
}
.button-secondary:hover { box-shadow: var(--shadow-lift); }

.badge {
  font-family: var(--font-mono);
  display: inline-flex;
  font-size: 15px;
  padding: 5px 10px;
  border-radius: var(--radius-btn);
  color: var(--color-accent);
  background: var(--color-accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
}
.badge:hover { border-color: var(--color-accent-border); }

.panel {
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-card);
  background: var(--color-ground);
}

.card-hover { transition: box-shadow 0.3s; }
.card-hover:hover { box-shadow: var(--shadow-lift); }

input, select, textarea {
  font-family: var(--font-sans);
  width: 100%;
  padding: 6px 12px;
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-pill);
  background: var(--color-ground);
  color: var(--color-heading);
  font-size: 15px;
  line-height: 145%;
  transition: border-color 0.3s;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--color-accent-border);
}
input::placeholder, textarea::placeholder { color: var(--color-body); }

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* htmx's request indicator. htmx injects these rules itself unless told not
   to; the htmx stacks tell it not to, so the policy can keep style-src 'self'. */
.htmx-indicator {
  opacity: 0;
}

.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator {
  opacity: 1;
  transition: opacity 200ms ease-in;
}
