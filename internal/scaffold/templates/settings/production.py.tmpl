[[if .Mailers]]from typing import TypedDict

[[end]]from django.core.exceptions import ImproperlyConfigured

from .base import *  # noqa: F401,F403

if ENVIRONMENT == "local":
    message = "settings.production refuses to run with ENVIRONMENT=local; set it to staging or production."
    raise ImproperlyConfigured(message)

SECRET_KEY = [[.Env.SecretKey]]

if SECRET_KEY == "[[.PlaceholderSecretKey]]":  # noqa: S105
    message = "SECRET_KEY is still the .env.example placeholder; generate a real one before deploying."
    raise ImproperlyConfigured(message)

ALLOWED_HOSTS = [[.Env.AllowedHosts]]

CSRF_TRUSTED_ORIGINS = [[.Env.CSRFOrigins]]

SECURE_SSL_REDIRECT = [[.Env.SSLRedirect]]
SECURE_REDIRECT_EXEMPT = [r"^healthz/$"]
SECURE_HSTS_SECONDS = [[.Env.HSTSSeconds]]
SECURE_HSTS_INCLUDE_SUBDOMAINS = [[.Env.HSTSSubdomains]]
SECURE_HSTS_PRELOAD = [[.Env.HSTSPreload]]
SESSION_COOKIE_SECURE = True
SESSION_COOKIE_SAMESITE = "Lax"
CSRF_COOKIE_SECURE = True
CSRF_COOKIE_SAMESITE = "Lax"

if [[.Env.TrustProxyHeader]]:
    SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
[[if .AllAuth]]
ACCOUNT_EMAIL_VERIFICATION = "mandatory"
[[end]]
DEFAULT_FROM_EMAIL = [[.Env.DefaultFromEmail]]
SERVER_EMAIL = DEFAULT_FROM_EMAIL
[[if .Mailers]]

class MailerOptions(TypedDict):
    host: str
    port: int
    username: str
    password: str
    use_tls: bool


class MailerConfig(TypedDict):
    BACKEND: str
    OPTIONS: MailerOptions


_DEFAULT_MAILER: MailerConfig = {
    "BACKEND": "django.core.mail.backends.smtp.EmailBackend",
    "OPTIONS": {
        "host": [[.Env.EmailHost]],
        "port": [[.Env.EmailPort]],
        "username": [[.Env.EmailUser]],
        "password": [[.Env.EmailPassword]],
        "use_tls": [[.Env.EmailUseTLS]],
    },
}

MAILERS = {"default": _DEFAULT_MAILER}
[[else]]
EMAIL_BACKEND = "django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST = [[.Env.EmailHost]]
EMAIL_PORT = [[.Env.EmailPort]]
EMAIL_HOST_USER = [[.Env.EmailUser]]
EMAIL_HOST_PASSWORD = [[.Env.EmailPassword]]
EMAIL_USE_TLS = [[.Env.EmailUseTLS]]
[[end]]
CACHES = {
    "default": {
        "BACKEND": "django.core.cache.backends.db.DatabaseCache",
        "LOCATION": "django_cache_table",
    },
}

STORAGES = {
    "default": {
        "BACKEND": "django.core.files.storage.FileSystemStorage",
