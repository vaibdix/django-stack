repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: [[.PreCommitHooksRev]]
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-merge-conflict
      - id: check-added-large-files
      - id: debug-statements
      - id: detect-private-key

  - repo: https://github.com/adamchainz/django-upgrade
    rev: "[[.DjangoUpgradeRev]]"
    hooks:
      - id: django-upgrade
        args: [--target-version, "[[.DjangoTrack]]"]
[[- if or .RuffEnabled .Templates .MypyEnabled .UVAvailable]]

  - repo: local
    hooks:
[[- end]]
[[- if .RuffEnabled]]
      - id: ruff-check
        name: ruff check
        entry: [[.RuffCheckEntry]]
        language: system
        types_or: [python, pyi]
        require_serial: true
      - id: ruff-format
        name: ruff format
        entry: [[.RuffFormatEntry]]
        language: system
        types_or: [python, pyi]
        require_serial: true
[[- end]]
[[- if .Templates]]
      - id: djlint
        name: djlint
        entry: [[.DjLintEntry]]
        language: system
        files: \.html$
[[- end]]
[[- if .MypyEnabled]]
      - id: mypy
        name: mypy
        entry: [[.MypyEntry]]
        language: system
        types: [python]
        pass_filenames: false
[[- end]]
[[- if .UVAvailable]]
      - id: uv-lock-check
        name: uv lock is up to date
        entry: uv lock --check
        language: system
        pass_filenames: false
        files: ^(pyproject\.toml|uv\.lock)$
[[- end]]
