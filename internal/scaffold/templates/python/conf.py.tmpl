from pathlib import Path
from typing import Annotated

from django.core.exceptions import ImproperlyConfigured
from pydantic import BeforeValidator
from pydantic import Field
from pydantic import ValidationError
from pydantic_settings import BaseSettings
from pydantic_settings import NoDecode
from pydantic_settings import SettingsConfigDict

BASE_DIR = Path(__file__).resolve().parent.parent


def _split_comma(value: object) -> object:
    """Read a comma-separated environment variable as a list.

    pydantic-settings decodes complex types as JSON, so without NoDecode a
    value like 'localhost,127.0.0.1' would be handed to json.loads and raise
    before the project ever starts.

    Typed object rather than Any: a before-validator really can be handed
    anything, and object is the type that forces the isinstance check below
    instead of silently allowing every operation.
    """
    if isinstance(value, str):
        return [item.strip() for item in value.split(',') if item.strip()]
    return value


CommaSeparated = Annotated[list[str], NoDecode, BeforeValidator(_split_comma)]

# A type is not a constraint. Declaring SECRET_KEY as str still accepts the
# empty string that .env.example ships, and a sample rate as float still accepts
# 9.5 — both would be caught much later, or not at all. These aliases put the
# bound where the value is read.
Port = Annotated[int, Field(ge=1, le=65535)]
SampleRate = Annotated[float, Field(ge=0.0, le=1.0)]

# 50 is Django's own SECRET_KEY_MIN_LENGTH, the threshold behind its security.W009
# check, and the length of the key this project was generated with.
SecretKey = Annotated[str, Field(min_length=50)]


class Settings(BaseSettings):
    """Every environment variable this project reads, validated at import time."""

    model_config = SettingsConfigDict(
        env_file=BASE_DIR / '.env',
        env_file_encoding='utf-8',
        extra='ignore',
    )

    SECRET_KEY: SecretKey
    DEBUG: bool = True
    ALLOWED_HOSTS: CommaSeparated = ['localhost', '127.0.0.1']
[[- if .Database]]

    DB_NAME: Annotated[str, Field(min_length=1)]
    DB_USER: str = '[[.DBUser]]'
    DB_PASSWORD: str = ''
    DB_HOST: str = 'localhost'
    DB_PORT: Port = [[.DBPort]]
[[- end]]

    SECURE_SSL_REDIRECT: bool = True
    SECURE_HSTS_SECONDS: Annotated[int, Field(ge=0)] = 31536000

    EMAIL_HOST: str = 'localhost'
    EMAIL_PORT: Port = 587
    EMAIL_HOST_USER: str = ''
    EMAIL_HOST_PASSWORD: str = ''
    EMAIL_USE_TLS: bool = True
[[- if .Sentry]]

    SENTRY_DSN: str = ''
    SENTRY_ENVIRONMENT: str = 'local'
    SENTRY_RELEASE: str = ''
    SENTRY_SEND_PII: bool = False
    SENTRY_TRACES_SAMPLE_RATE: SampleRate = 0.0
    SENTRY_PROFILE_SESSION_SAMPLE_RATE: SampleRate = 0.0
[[- end]]


try:
    env = Settings()
except ValidationError as error:
    # A raw pydantic traceback surfaces through Django's settings machinery and
    # buries the one line that matters. ImproperlyConfigured is the vocabulary
    # an operator already knows, and Django prints it without the stack.
    raise ImproperlyConfigured(f'Invalid environment configuration:\n{error}') from error
