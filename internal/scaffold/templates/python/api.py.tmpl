from drf_spectacular.utils import OpenApiParameter
from drf_spectacular.utils import extend_schema
from drf_spectacular.utils import extend_schema_view
[[- if .Pydantic]]
from pydantic import ValidationError
[[- end]]
from rest_framework import filters
from rest_framework import routers
from rest_framework import viewsets
from rest_framework.decorators import action
[[- if .Pydantic]]
from rest_framework.exceptions import ValidationError as DRFValidationError
[[- end]]
from rest_framework.request import Request
from rest_framework.response import Response
[[- if .Pydantic]]
from rest_framework.serializers import BaseSerializer
[[- end]]

from .models import Book
from .models import BookQuerySet
[[- if .Pydantic]]
from .schemas import BookIn
from .schemas import field_errors
[[- end]]
from .serializers import BookSerializer

SEARCH_PARAMETER = OpenApiParameter(
    name='search',
    type=str,
    location=OpenApiParameter.QUERY,
    description='Match against title, author or ISBN.',
)


@extend_schema_view(
    list=extend_schema(parameters=[SEARCH_PARAMETER]),
    recent=extend_schema(parameters=[SEARCH_PARAMETER]),
)
class BookViewSet(viewsets.ModelViewSet[Book]):
    serializer_class = BookSerializer
    filter_backends = (filters.OrderingFilter,)
    ordering_fields = ('title', 'publication_date', 'price', 'created_at')

    def get_queryset(self) -> BookQuerySet:
        return Book.objects.search(self.request.query_params.get('search', ''))
[[- if .Pydantic]]

    def perform_create(self, serializer: BaseSerializer[Book]) -> None:
        serializer.save(**self.validated_payload(serializer).model_dump())

    def perform_update(self, serializer: BaseSerializer[Book]) -> None:
        serializer.save(**self.validated_payload(serializer).model_dump())

    @staticmethod
    def validated_payload(serializer: BaseSerializer[Book]) -> BookIn:
        try:
            return BookIn.model_validate(serializer.validated_data)
        except ValidationError as error:
            raise DRFValidationError(field_errors(error)) from error
[[- end]]

    @action(detail=False, methods=['get'])
    def recent(self, request: Request) -> Response:
        recent_books = self.filter_queryset(self.get_queryset().recent())
        page = self.paginate_queryset(recent_books)
        if page is not None:
            return self.get_paginated_response(self.get_serializer(page, many=True).data)
        return Response(self.get_serializer(recent_books, many=True).data)


router = routers.DefaultRouter()
router.register(r'books', BookViewSet, basename='book')

urlpatterns = router.urls
