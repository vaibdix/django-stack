app_name_var = '[[.AppName]]'
[[if .Pydantic]]

def validated(form: BookForm) -> BookIn:
    """Read a valid form as a typed object rather than dict[str, Any].

    Django types cleaned_data as dict[str, Any], so every field taken from it is
    unchecked. Parsing it here keeps the HTML path as well typed as the API one.
    """
    return BookIn.model_validate(form.cleaned_data)
[[end]]

def book_list(request: [[if .HTMX]]HtmxHttpRequest[[else]]HttpRequest[[end]]) -> HttpResponse:
    books = Book.objects.search(request.GET.get('q', ''))
[[- if .HTMX]]
    if wants_fragment(request):
        return render(request, app_name_var + '/partials/book_list_items.html', {'books': books})
[[- end]]
    return render(request, app_name_var + '/book_list.html', {'books': books})


def book_create(request: [[if .HTMX]]HtmxHttpRequest[[else]]HttpRequest[[end]]) -> HttpResponse:
    if request.method == 'POST':
        form = BookForm(request.POST)
        if form.is_valid():
[[- if .Pydantic]]
            Book.objects.create(**validated(form).model_dump())
[[- else]]
            form.save()
[[- end]]
            messages.success(request, 'Book created successfully!')
[[- if .HTMX]]
            if wants_fragment(request):
                return render(request, app_name_var + '/partials/book_list_items.html', {'books': Book.objects.all()})
[[- end]]
            return redirect(reverse(app_name_var + ':book_list'))
    else:
        form = BookForm()
[[- if .HTMX]]
    if wants_fragment(request):
        template = app_name_var + '/partials/book_form_partial.html'
    else:
        template = app_name_var + '/book_form.html'
    return render(request, template, {'form': form, 'action': 'Create'})
[[- else]]
    return render(request, app_name_var + '/book_form.html', {'form': form, 'action': 'Create'})
[[- end]]


def book_edit(request: [[if .HTMX]]HtmxHttpRequest[[else]]HttpRequest[[end]], pk: int) -> HttpResponse:
    book = get_object_or_404(Book, pk=pk)
    if request.method == 'POST':
        form = BookForm(request.POST, instance=book)
        if form.is_valid():
[[- if .Pydantic]]
            for field, value in validated(form).model_dump().items():
                setattr(book, field, value)
            book.save()
[[- else]]
            form.save()
[[- end]]
            messages.success(request, 'Book updated successfully!')
[[- if .HTMX]]
            if wants_fragment(request):
                return render(request, app_name_var + '/partials/book_list_items.html', {'books': Book.objects.all()})
[[- end]]
            return redirect(reverse(app_name_var + ':book_list'))
    else:
        form = BookForm(instance=book)
[[- if .HTMX]]
    if wants_fragment(request):
        template = app_name_var + '/partials/book_form_partial.html'
    else:
        template = app_name_var + '/book_form.html'
    return render(request, template, {'form': form, 'action': 'Edit', 'book': book})
[[- else]]
    return render(request, app_name_var + '/book_form.html', {'form': form, 'action': 'Edit', 'book': book})
[[- end]]


def book_delete(request: [[if .HTMX]]HtmxHttpRequest[[else]]HttpRequest[[end]], pk: int) -> HttpResponse:
    book = get_object_or_404(Book, pk=pk)
    if request.method == 'POST':
        book.delete()
        messages.success(request, 'Book deleted successfully!')
[[- if .HTMX]]
        if wants_fragment(request):
            return HttpResponse('')
[[- end]]
        return redirect(reverse(app_name_var + ':book_list'))
    return render(request, app_name_var + '/book_delete.html', {'book': book})
[[- if .HTMX]]


def book_search(request: [[if .HTMX]]HtmxHttpRequest[[else]]HttpRequest[[end]]) -> HttpResponse:
    query = request.GET.get('q', '').strip()
    books = Book.objects.search(query)
    if wants_fragment(request):
        return render(request, app_name_var + '/partials/book_list_items.html', {'books': books})
    return render(request, app_name_var + '/book_list.html', {'books': books, 'query': query})
[[- end]]
