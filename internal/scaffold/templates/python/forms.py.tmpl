from django import forms

from .models import Book

class BookForm(forms.ModelForm):
    class Meta:
        model = Book
        fields = ['title', 'author', 'isbn', 'publication_date', 'price']
        widgets = {
            'title': forms.TextInput(attrs={'class': '[[.InputClass]]', 'placeholder': 'Atomic Habits'}),
            'author': forms.TextInput(attrs={'class': '[[.InputClass]]', 'placeholder': 'James Clear'}),
            'isbn': forms.TextInput(attrs={'class': '[[.InputClass]]', 'placeholder': '9780735211292'}),
            'publication_date': forms.DateInput(attrs={'class': '[[.InputClass]]', 'type': 'date'}),
            'price': forms.NumberInput(attrs={'class': '[[.InputClass]]', 'placeholder': '24.99', 'step': '0.01'}),
        }
