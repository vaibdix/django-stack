from django import forms

from .models import Book

[[if .Tailwind]]# Shared widget styling. Kept as a module constant rather than repeated inline
# even though the token form is shorter than the opacity-literal one it replaced:
# inlining it in every widget is what produced the 300-character lines that ruff
# rejects with E501 and cannot autofix, aborting the scaffold's formatting pass.
INPUT_CLASS = (
    "w-full rounded-xl border border-rule bg-surface px-4 py-3 "
    "text-sm text-heading placeholder:text-body outline-none "
    "transition focus:border-accent"
)
[[else]]INPUT_CLASS = ""
[[end]]

class BookForm(forms.ModelForm):
    class Meta:
        model = Book
        fields = ['title', 'author', 'isbn', 'publication_date', 'price']
        widgets = {
            'title': forms.TextInput(attrs={'class': INPUT_CLASS, 'placeholder': 'Atomic Habits'}),
            'author': forms.TextInput(attrs={'class': INPUT_CLASS, 'placeholder': 'James Clear'}),
            'isbn': forms.TextInput(attrs={'class': INPUT_CLASS, 'placeholder': '9780735211292'}),
            'publication_date': forms.DateInput(attrs={'class': INPUT_CLASS, 'type': 'date'}),
            'price': forms.NumberInput(attrs={'class': INPUT_CLASS, 'placeholder': '24.99', 'step': '0.01'}),
        }
