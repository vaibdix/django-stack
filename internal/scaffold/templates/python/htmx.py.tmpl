from typing import cast

from django.http import HttpRequest as HttpRequestBase
from django_htmx.middleware import HtmxDetails


class HtmxHttpRequest(HttpRequestBase):
    """The request HtmxMiddleware actually produces.

    django-htmx sets request.htmx on every request but ships no type for it, so
    a plain HttpRequest annotation makes request.htmx an attr-defined error.
    Declaring the attribute here is the pattern django-htmx documents, borrowed
    in turn from django-stubs.
    """

    htmx: HtmxDetails


def wants_fragment(request: HttpRequestBase) -> bool:
    """True for a real partial request, False for boosted navigation.

    hx-boost sets HX-Request on ordinary link and form navigation, which still
    needs the whole page. Only a targeted hx-get/hx-post should get a fragment.
    """
    htmx = cast("HtmxHttpRequest", request).htmx
    return bool(htmx) and not htmx.boosted


class HtmxTemplateMixin:
    """Serves a fragment when htmx asks for one and the full page otherwise."""

    fragment_template_name: str
    full_template_name: str

    request: HttpRequestBase

    def get_template_names(self) -> list[str]:
        if wants_fragment(self.request):
            return [self.fragment_template_name]
        return [self.full_template_name]
