# Django Stack - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === Django Settings ===
# local | test | staging | production. This is the only switch for DEBUG,
# which is on for local and test.
ENVIRONMENT=local
# Required, at least 50 characters. Replace the placeholder below with:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-this-placeholder-with-a-generated-50-char-key
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (PostgreSQL Docker) ===
DB_NAME=my_shop
DB_USER=postgres
DB_PASSWORD=<set-password>
DB_HOST=localhost
DB_PORT=5432

# === Email (read by settings.production) ===
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=webmaster@localhost

# === Production security (read by settings.production) ===
# ADMIN_URL=admin/
# CSRF_TRUSTED_ORIGINS=https://example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# TRUST_PROXY_SSL_HEADER=False
