# Django Stack - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === Django Settings ===
# local | test | staging | production. This is the only switch for DEBUG.
ENVIRONMENT=local
# Required, at least 50 characters. Replace the placeholder below with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=replace-this-placeholder-with-a-generated-50-char-key
ALLOWED_HOSTS=localhost,127.0.0.1

# === Email (read by settings.production) ===
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=webmaster@localhost

# === Production security (read by settings.production) ===
# ADMIN_URL=admin/
# CSRF_TRUSTED_ORIGINS=https://example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# TRUST_PROXY_SSL_HEADER=False
