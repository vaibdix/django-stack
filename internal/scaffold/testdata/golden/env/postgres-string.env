# Django Stack - Environment Variables
# NEVER commit this file to version control

# === Django Settings ===
# local | test | staging | production. This is the only switch for DEBUG.
ENVIRONMENT=local
SECRET_KEY=abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*(-_=+)
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (PostgreSQL) ===
# Update the password and host below with your PostgreSQL credentials
DB_NAME=my_shop
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
