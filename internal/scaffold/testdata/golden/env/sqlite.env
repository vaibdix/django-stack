# Django Stack - Environment Variables
# NEVER commit this file to version control

# === Django Settings ===
# local | test | staging | production. This is the only switch for DEBUG,
# which is on for local and test.
ENVIRONMENT=local
SECRET_KEY=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwx
ALLOWED_HOSTS=localhost,127.0.0.1

# === Email (read in staging and production) ===
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# The sender of account email; production refuses Django's webmaster@localhost.
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
