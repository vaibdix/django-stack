[[template "page-head" .]]
    {% load static %}[[if .HTMX]]
    {% load django_htmx %}[[end]]
    <link rel="stylesheet" href="{% static 'css/base.css' %}">
    <link rel="stylesheet" href="{% static 'css/home.css' %}">
    <link rel="stylesheet" href="{% static 'css/app.css' %}">
    <link rel="stylesheet" href="{% static 'css/auth.css' %}">[[template "htmx-script" .]]
    {% block extra_head %}{% endblock %}
</head>
<body[[template "htmx-body" .]]>
  <div class="frame"[[template "htmx-frame" .]]>
    <header>
        <div class="container">
            <div class="header-content">
                <a href="{% url 'home' %}" class="logo">
                    <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                        <rect width="32" height="32" rx="6" fill="currentColor" opacity="0.12"/>
                        <path d="M12 8L20 16L12 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <h1>{{ project_name }}</h1>
                </a>
                <nav><a href="{% url 'home' %}">Home</a>[[if .AppName]]<a href="{% url '[[.AppName]]:[[.AppRoute]]' %}">[[.AppTitle]]</a>[[end]][[if .API]]<a[[.Boost]] href="{% url '[[.DocsRoute]]' %}">API Docs</a>[[end]]<a[[.Boost]] href="{% url 'admin:index' %}">Admin</a>[[if .AllAuth]]{% if user.is_authenticated %}<a href="{% url 'account_logout' %}">Logout</a>{% else %}<a href="{% url 'account_login' %}">Login</a><a href="{% url 'account_signup' %}">Sign Up</a>{% endif %}[[else]]{% if user.is_authenticated %}<form method="post" action="{% url 'logout' %}" class="nav-form">{% csrf_token %}<button type="submit">Logout</button></form>{% else %}<a href="{% url 'login' %}">Login</a>{% endif %}[[end]]</nav>
            </div>
        </div>
    </header>
    <main>
        {% if messages %}
        <ul class="messages" role="status">
            {% for message in messages %}
            <li{% if message.tags %} class="{{ message.tags }}"{% endif %}>{{ message }}</li>
            {% endfor %}
        </ul>
        {% endif %}
        {% block content %}{% endblock %}
    </main>
    <section id="next-steps" class="ticks">
        <div id="docs">
            <svg class="icon" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">[[template "icon-docs"]]</svg>
            <h2>Documentation</h2>
            <p>Your questions, answered</p>
            <ul>
                <li><a[[.Boost]] href="https://docs.djangoproject.com/">Explore Django</a></li>
                <li><a[[.Boost]] href="{% url 'admin:index' %}">Open admin</a></li>
            </ul>
        </div>
        <div id="build">
            <svg class="icon" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">[[template "icon-build"]]</svg>
            <h2>Start building</h2>
            <p>Register a model and it appears in the admin</p>
            <ul>
                <li><a[[.Boost]] href="https://docs.djangoproject.com/en/stable/intro/tutorial01/">Tutorial</a></li>
                <li><a[[.Boost]] href="https://docs.djangoproject.com/en/stable/ref/models/">Model reference</a></li>
            </ul>
        </div>
    </section>
    <div class="ticks"></div>
    <footer>
        <div class="footer-bottom"><p>© {% now "Y" %} {{ project_name }}</p></div>
    </footer>
[[template "page-tail"]]