{% for book in books %}
    <article id="book-{{ book.id }}" class="book-card">
        <div class="book-card-header">
            <h3 class="book-card-title">{{ book.title }}</h3>
        </div>
        <div class="book-card-details">
            <div class="book-card-row"><span>Author</span><span class="book-card-row-value">{{ book.author }}</span></div>
            <div class="book-card-row"><span>ISBN</span><span class="book-card-row-value">{{ book.isbn }}</span></div>
            <div class="book-card-row"><span>Published</span><span class="book-card-row-value">{{ book.publication_date }}</span></div>
            <div class="book-card-row"><span>Price</span><span class="book-card-row-value">{{ book.price }}</span></div>
        </div>
        <div class="book-card-actions">
            [[tag 12 "a" "href" (print "{% url '" .AppName ":book_edit' book.id %}") "class" "button button-secondary"]]Edit</a>
[[- if .HTMX]]
            <button type="button"
                    hx-post="{% url '[[.AppName]]:book_delete' book.id %}"
                    hx-target="closest article"
                    hx-swap="outerHTML"
                    hx-confirm="Delete this book?"
                    class="button button-primary">Delete</button>
[[- else]]
            [[tag 12 "a" "href" (print "{% url '" .AppName ":book_delete' book.id %}") "class" "button button-primary"]]Delete</a>
[[- end]]
        </div>
    </article>
{% empty %}
    <div class="book-empty book-empty--full">
        {% if query %}
            <p class="book-empty-desc">No books match “{{ query }}”.</p>
        {% else %}
            <h2>No books yet</h2>
            <p class="book-empty-desc">Start with a single title and the library becomes visible in both this page and the Django admin.</p>
            <div class="book-empty-actions">
                [[tag 16 "a" "href" (print "{% url '" .AppName ":book_create' %}") "class" "button button-primary"]]Add your first book</a>
[[- if .HTMX]]
                <a hx-boost="false"
                   href="{% url 'admin:index' %}"
                   class="button button-secondary">Open Django admin</a>
[[- else]]
                <a href="{% url 'admin:index' %}" class="button button-secondary">Open Django admin</a>
[[- end]]
            </div>
        {% endif %}
    </div>
{% endfor %}
{% if page_obj.has_other_pages %}
    <nav class="pagination" aria-label="Pagination">
        {% if page_obj.has_previous %}
[[- if .HTMX]]
            <a hx-get="{% url '[[.AppName]]:book_list' %}?q={{ query|urlencode }}&page={{ page_obj.previous_page_number }}"
               hx-target="#book-list"
               hx-swap="innerHTML"
               hx-push-url="true"
               href="?q={{ query|urlencode }}&page={{ page_obj.previous_page_number }}"
[[- else]]
            <a href="?q={{ query|urlencode }}&page={{ page_obj.previous_page_number }}"
[[- end]]
               class="button button-secondary">Previous</a>
        {% endif %}
        <span class="pagination-status">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
        {% if page_obj.has_next %}
[[- if .HTMX]]
            <a hx-get="{% url '[[.AppName]]:book_list' %}?q={{ query|urlencode }}&page={{ page_obj.next_page_number }}"
               hx-target="#book-list"
               hx-swap="innerHTML"
               hx-push-url="true"
               href="?q={{ query|urlencode }}&page={{ page_obj.next_page_number }}"
[[- else]]
            <a href="?q={{ query|urlencode }}&page={{ page_obj.next_page_number }}"
[[- end]]
               class="button button-secondary">Next</a>
        {% endif %}
    </nav>
{% endif %}
