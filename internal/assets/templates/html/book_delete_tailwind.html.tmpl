{% extends "base.html" %}
{% block title %}Delete Book - [[.AppName]]{% endblock %}
{% block content %}
    <section class="flex min-h-[50vh] items-center justify-center px-5 py-10">
        <div class="panel w-full max-w-[560px] p-6 text-center">
            <h2>Delete this book?</h2>
            <p class="mx-auto max-w-[420px] text-body">You are about to remove <span class="text-heading">{{ book.title }}</span>. It disappears from this page and from Django admin immediately.</p>
            <form method="post" class="mt-6 flex justify-center gap-2 max-sm:flex-col">
                {% csrf_token %}
                [[tag 16 "a" "href" (print "{% url '" .AppName ":book_list' %}") "class" "button button-secondary"]]Keep book</a>
                <button type="submit" class="button button-primary">Delete permanently</button>
            </form>
        </div>
    </section>
{% endblock %}
