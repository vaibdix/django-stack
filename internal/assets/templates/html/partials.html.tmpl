[[define "page-head"]]<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ project_name }} — a Django application.">
    <title>{% block title %}{{ project_name }}{% endblock %}</title>[[end]]
[[- define "htmx-script"]][[if .HTMX]]
    <meta name="htmx-config" content='{"includeIndicatorStyles": false, "allowEval": false}'>
    {% htmx_script %}[[end]][[end]]
[[- define "htmx-body"]][[if .HTMX]] hx-boost="true"[[end]][[end]]
[[- define "htmx-frame"]][[if .HTMX]] hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'[[end]][[end]]
[[- define "icon-docs"]]<path d="M4 3h9l5 5v11H4z"/><path d="M13 3v5h5"/>[[end]]
[[- define "icon-build"]]<path d="M11 2l7 4v10l-7 4-7-4V6z"/><path d="M11 11l7-4M11 11v9M11 11L4 7"/>[[end]]
[[- define "page-tail"]]  </div>
    <script src="{% static 'js/main.js' %}"></script>
    {% block extra_body %}{% endblock %}
</body>
</html>[[end]]
[[- define "hero-copy"]]Edit <code>{{ project_name }}/views.py</code> and save to see your changes[[end]]
[[- define "feature-fast"]]A batteries-included framework: the admin, the ORM and the auth system are already here.[[end]]
[[- define "feature-secure"]]Argon2 hashing, CSRF protection and secure cookie defaults are configured from the first run.[[end]]
