{% load static %}
[[- if .HTMX]]
{% load django_htmx %}
[[- end]]
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description"
              content="{{ project_name }} — a Django application.">
        <title>{% block title %}{{ project_name }}{% endblock %}</title>
        <link rel="stylesheet" href="{% static 'dist/styles.css' %}">
[[- if .HTMX]]
        <meta name="htmx-config"
              content='{"includeIndicatorStyles": false, "allowEval": false}'>
        {% htmx_script %}
[[- end]]
        {% block extra_head %}{% endblock %}
    </head>
[[- if .HTMX]]
    <body hx-boost="true">
        <div class="frame" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>
[[- else]]
    <body>
        <div class="frame">
[[- end]]
            <header class="border-b border-rule">
                <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-8 py-4 max-lg:px-5">
                    <a href="{% url 'home' %}"
                       class="flex items-center gap-2.5 text-heading no-underline">
                        <svg width="24"
                             height="24"
                             viewBox="0 0 32 32"
                             fill="none"
                             aria-hidden="true">
                            <rect width="32" height="32" rx="6" fill="currentColor" opacity="0.12" />
                            <path d="M12 8L20 16L12 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="text-[17px] font-medium tracking-[-0.17px] text-heading">{{ project_name }}</span>
                    </a>
                    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2">
                        <a href="{% url 'home' %}"
                           class="text-body transition-colors duration-300 hover:text-heading">Home</a>
[[- if .AppName]]
                        <a href="{% url '[[.AppName]]:[[.AppRoute]]' %}"
                           class="text-body transition-colors duration-300 hover:text-heading">[[.AppTitle]]</a>
[[- end]]
[[- if .API]]
[[- if .HTMX]]
                        <a hx-boost="false"
                           href="{% url '[[.DocsRoute]]' %}"
[[- else]]
                        <a href="{% url '[[.DocsRoute]]' %}"
[[- end]]
                           class="text-body transition-colors duration-300 hover:text-heading">API Docs</a>
[[- end]]
[[- if .HTMX]]
                        <a hx-boost="false"
                           href="{% url 'admin:index' %}"
[[- else]]
                        <a href="{% url 'admin:index' %}"
[[- end]]
                           class="text-body transition-colors duration-300 hover:text-heading">Admin</a>
[[- if .HTMX]]
                        <a hx-boost="false"
                           href="https://docs.djangoproject.com/"
[[- else]]
                        <a href="https://docs.djangoproject.com/"
[[- end]]
                           class="text-body transition-colors duration-300 hover:text-heading">Docs</a>
                        {% if user.is_authenticated %}
[[- if .AllAuth]]
                            <a href="{% url 'account_logout' %}"
                               class="text-body transition-colors duration-300 hover:text-heading">Logout</a>
[[- else]]
                            <form method="post" action="{% url 'logout' %}" class="m-0 inline">
                                {% csrf_token %}
                                <button type="submit"
                                        class="cursor-pointer border-0 bg-transparent p-0 text-body transition-colors duration-300 hover:text-heading">Logout</button>
                            </form>
[[- end]]
                        {% else %}
[[- if .AllAuth]]
                            <a href="{% url 'account_login' %}"
[[- else]]
                            <a href="{% url 'login' %}"
[[- end]]
                               class="text-body transition-colors duration-300 hover:text-heading">Login</a>
[[- if .AllAuth]]
                            <a href="{% url 'account_signup' %}"
                               class="text-body transition-colors duration-300 hover:text-heading">Sign Up</a>
[[- end]]
                        {% endif %}
                    </nav>
                </div>
            </header>
            <main class="flex-grow">
                {% if messages %}
                    <ul class="mx-8 mt-6 list-none space-y-2 p-0 max-lg:mx-5" role="status">
                        {% for message in messages %}
                            <li class="rounded-[6px] border border-rule bg-surface px-3 py-2 text-body">{{ message }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% block content %}{% endblock %}
            </main>
            <section id="next-steps"
                     class="ticks flex text-left max-lg:flex-col max-lg:text-center">
                <div class="flex-1 border-r border-rule p-6 max-lg:border-r-0 max-lg:border-b max-lg:p-5">
                    <svg class="mb-4 h-[22px] w-[22px] text-accent"
                         viewBox="0 0 22 22"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6"
                         aria-hidden="true">
                        <path d="M4 3h9l5 5v11H4z" />
                        <path d="M13 3v5h5" />
                    </svg>
                    <h2>Documentation</h2>
                    <p>Your questions, answered</p>
                    <ul class="m-0 mt-5 flex list-none gap-2 p-0 max-lg:mt-4 max-lg:flex-wrap max-lg:justify-center">
[[- if .HTMX]]
                        <li class="max-lg:flex-1"><a hx-boost="false"
   href="https://docs.djangoproject.com/"
[[- else]]
                        <li class="max-lg:flex-1"><a href="https://docs.djangoproject.com/"
[[- end]]
   class="button button-secondary max-lg:w-full">Explore Django</a></li>
[[- if .HTMX]]
                        <li class="max-lg:flex-1"><a hx-boost="false"
   href="{% url 'admin:index' %}"
[[- else]]
                        <li class="max-lg:flex-1"><a href="{% url 'admin:index' %}"
[[- end]]
   class="button button-secondary max-lg:w-full">Open admin</a></li>
                    </ul>
                </div>
                <div class="flex-1 p-6 max-lg:p-5">
                    <svg class="mb-4 h-[22px] w-[22px] text-accent"
                         viewBox="0 0 22 22"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.6"
                         aria-hidden="true">
                        <path d="M11 2l7 4v10l-7 4-7-4V6z" />
                        <path d="M11 11l7-4M11 11v9M11 11L4 7" />
                    </svg>
                    <h2>Start building</h2>
                    <p>Register a model and it appears in the admin</p>
                    <ul class="m-0 mt-5 flex list-none gap-2 p-0 max-lg:mt-4 max-lg:flex-wrap max-lg:justify-center">
[[- if .HTMX]]
                        <li class="max-lg:flex-1"><a hx-boost="false"
   href="https://docs.djangoproject.com/en/stable/intro/tutorial01/"
[[- else]]
                        <li class="max-lg:flex-1"><a href="https://docs.djangoproject.com/en/stable/intro/tutorial01/"
[[- end]]
   class="button button-secondary max-lg:w-full">Tutorial</a></li>
[[- if .HTMX]]
                        <li class="max-lg:flex-1"><a hx-boost="false"
   href="https://docs.djangoproject.com/en/stable/ref/models/"
[[- else]]
                        <li class="max-lg:flex-1"><a href="https://docs.djangoproject.com/en/stable/ref/models/"
[[- end]]
   class="button button-secondary max-lg:w-full">Model reference</a></li>
                    </ul>
                </div>
            </section>
            <div class="ticks"></div>
            <footer class="border-t border-rule">
                <div class="flex flex-col items-center gap-2 px-8 py-4 text-body sm:flex-row sm:justify-between max-lg:px-5">
                    <p>© {% now "Y" %} {{ project_name }}</p>
                    <p>Generated by django-stack</p>
                </div>
            </footer>
        </div>
        <script src="{% static 'js/main.js' %}"></script>
        {% block extra_body %}{% endblock %}
    </body>
</html>
