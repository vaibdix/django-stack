{% load static %}[[if .HTMX]]
{% load django_htmx %}[[end]]
[[template "page-head" .]]
    <link rel="stylesheet" href="{% static 'dist/styles.css' %}">[[template "htmx-script" .]]
    {% block extra_head %}{% endblock %}
</head>
<body[[template "htmx-body" .]]>
  <div class="frame"[[template "htmx-frame" .]]>
    <header class="border-b border-rule">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-8 py-4 max-lg:px-5">
            <a href="{% url 'home' %}" class="flex items-center gap-2.5 text-heading no-underline">
                <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                    <rect width="32" height="32" rx="6" fill="currentColor" opacity="0.12"/>
                    <path d="M12 8L20 16L12 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-[17px] font-medium tracking-[-0.17px] text-heading">{{ project_name }}</span>
            </a>
            <nav class="flex flex-wrap items-center gap-x-5 gap-y-2">
                <a href="{% url 'home' %}" class="[[.NavClass]]">Home</a>[[if .AppName]]
                    <a href="{% url '[[.AppName]]:[[.AppRoute]]' %}" class="[[.NavClass]]">[[.AppTitle]]</a>[[end]]
                [[if .API]]
                    <a[[.Boost]] href="{% url '[[.DocsRoute]]' %}" class="[[.NavClass]]">API Docs</a>[[end]]
                <a[[.Boost]] href="{% url 'admin:index' %}" class="[[.NavClass]]">Admin</a>
                <a[[.Boost]] href="https://docs.djangoproject.com/" class="[[.NavClass]]">Docs</a>[[if .AllAuth]]
                    {% if user.is_authenticated %}
                    <a href="{% url 'account_logout' %}" class="[[.NavClass]]">Logout</a>
                    {% else %}
                    <a href="{% url 'account_login' %}" class="[[.NavClass]]">Login</a>
                    <a href="{% url 'account_signup' %}" class="[[.NavClass]]">Sign Up</a>
                    {% endif %}[[else]]
                    {% if user.is_authenticated %}
                    <form method="post" action="{% url 'logout' %}" class="m-0 inline">
                        {% csrf_token %}
                        <button type="submit" class="cursor-pointer border-0 bg-transparent p-0 [[.NavClass]]">Logout</button>
                    </form>
                    {% else %}
                    <a href="{% url 'login' %}" class="[[.NavClass]]">Login</a>
                    {% endif %}[[end]]
            </nav>
        </div>
    </header>
    <main class="flex-grow">
        {% if messages %}
        <ul class="mx-8 mt-6 list-none space-y-2 p-0 max-lg:mx-5" role="status">
            {% for message in messages %}
            <li class="rounded-[6px] border border-rule bg-surface px-3 py-2 text-body">{{ message }}</li>
            {% endfor %}
        </ul>
        {% endif %}
        {% block content %}{% endblock %}
    </main>
    <section id="next-steps" class="ticks flex text-left max-lg:flex-col max-lg:text-center">
        <div class="flex-1 border-r border-rule p-6 max-lg:border-r-0 max-lg:border-b max-lg:p-5">
            <svg class="mb-4 h-[22px] w-[22px] text-accent" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">[[template "icon-docs"]]</svg>
            <h2>Documentation</h2>
            <p>Your questions, answered</p>
            <ul class="m-0 mt-5 flex list-none gap-2 p-0 max-lg:mt-4 max-lg:flex-wrap max-lg:justify-center">
                <li class="max-lg:flex-1"><a[[.Boost]] href="https://docs.djangoproject.com/" class="button button-secondary max-lg:w-full">Explore Django</a></li>
                <li class="max-lg:flex-1"><a[[.Boost]] href="{% url 'admin:index' %}" class="button button-secondary max-lg:w-full">Open admin</a></li>
            </ul>
        </div>
        <div class="flex-1 p-6 max-lg:p-5">
            <svg class="mb-4 h-[22px] w-[22px] text-accent" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">[[template "icon-build"]]</svg>
            <h2>Start building</h2>
            <p>Register a model and it appears in the admin</p>
            <ul class="m-0 mt-5 flex list-none gap-2 p-0 max-lg:mt-4 max-lg:flex-wrap max-lg:justify-center">
                <li class="max-lg:flex-1"><a[[.Boost]] href="https://docs.djangoproject.com/en/stable/intro/tutorial01/" class="button button-secondary max-lg:w-full">Tutorial</a></li>
                <li class="max-lg:flex-1"><a[[.Boost]] href="https://docs.djangoproject.com/en/stable/ref/models/" class="button button-secondary max-lg:w-full">Model reference</a></li>
            </ul>
        </div>
    </section>
    <div class="ticks"></div>
    <footer class="border-t border-rule">
        <div class="flex flex-col items-center gap-2 px-8 py-4 text-body sm:flex-row sm:justify-between max-lg:px-5">
            <p>© {% now "Y" %} {{ project_name }}</p>
            <p>Generated by django-stack</p>
        </div>
    </footer>
[[template "page-tail"]]