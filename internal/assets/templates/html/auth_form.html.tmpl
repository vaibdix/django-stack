{% extends "base.html" %}
{% block title %}[[.Page.Title]]{% endblock %}
{% block content %}
[[.Style.Open]]
[[- if .Page.Unless]]
            {% if [[.Page.Unless.Variable]] %}
                <h2>[[.Page.Unless.Heading]]</h2>
                <p class="[[.Style.Subtitle]]">[[.Page.Unless.Subtitle]]</p>
                [[tag 16 "a" "href" (print "{% url '" .Page.Unless.Route "' %}") "class" .Style.Submit]][[.Page.Unless.Link]]</a>
            {% else %}
[[- end]]
[[.Body]]
[[- if .Page.Unless]]
            {% endif %}
[[- end]]
[[.Style.Close]]
{% endblock %}
