<form method="post"
      hx-post="{{ request.path }}"
      hx-target="this"
      hx-swap="outerHTML"
      class="form-panel">
    {% csrf_token %}
    {% include "[[.AppName]]/partials/book_fields.html" %}
    <div class="form-actions">
        [[tag 8 "a" "href" (print "{% url '" .AppName ":book_list' %}") "class" "button button-secondary"]]Cancel</a>
        <button type="submit" class="button button-primary">{{ action }} book</button>
    </div>
</form>
