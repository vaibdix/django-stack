{% extends "base.html" %}
{% block title %}[[.Code]] — [[.Title]]{% endblock %}
{% block content %}
<section class="error-page">
    <div class="error-card">
        <code>[[.Code]]</code>
        <h1>[[.Title]]</h1>
        <p>[[.Message]]</p>
        <a href="{% url 'home' %}" class="button button-primary">Back to home</a>
    </div>
</section>
{% endblock %}
